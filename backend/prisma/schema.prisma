generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(uuid())
  fullName          String
  email             String   
  passwordHash      String?
  role              Role  
  profileImageUrl   String?  @default("")
  status            Status   @default(ACTIVE)
  googleId          String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  mentorProfile  mentorProfile?
  
  @@unique([email,role])
  @@index([createdAt])
}

enum Role {
    STUDENT
    MENTOR
    ADMIN
}
enum Status {
    ACTIVE
    SUSPENDED
    PENDING_APPROVAL
    APPROVED
}

model StudentProfile {
  studentId      String   @id
  timezone       String?
  currentGoal    String?
  bio            String?
  followingCount Int      @default(0)
  joinedAt       DateTime @default(now())

  user User @relation(fields: [studentId],references: [id],onDelete: Cascade)
}

model mentorProfile {
  mentorId String  @id
  headline       String?
  bio            String?
  sessionPrice   Decimal @default(0) @db.Decimal(10, 2)
  yearsExperience Int @default(0)
  verificationStatus Status @default(ACTIVE)
  followerCount  Int @default(0)
  averageRating  Decimal @default(0) @db.Decimal(3, 2)
  timezone       String?
  approvedAt     DateTime?
  teachingSubjects  String? 
  availabilitySlots AvailabilitySlot[]
  channels Channel[]
  channelPosts ChannelPost[]

  user User @relation(fields: [mentorId], references: [id], onDelete: Cascade)
}


model mentorSkill {
  skillId    String @id @default(uuid())
  mentorId   String 
  skillName  String
  subtopics  String?
  proficiencyLevel  ProficiencyLevel
}

enum ProficiencyLevel {
  ADVANCED
  INTERMEDIATE
  EXPERT
}

model mentorExperience {
  experienceId  String  @id @default(uuid())
  mentorId      String  
  title         String
  company       String?
  employmentType EmploymentTypes
  workPlaceType  WorkPlaceTypes
  location      String?
  startDate       DateTime
  endDate         DateTime?
  isCurrent       Boolean  @default(false)
  description     String?     

}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  description  String?
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

enum EmploymentTypes{
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
}
enum WorkPlaceTypes{
  REMOTE
  ONSITE
  HYBRID
}

model AvailabilitySlot {
  slotId    String   @id @default(uuid())
  mentorId  String
  date      DateTime @db.Date
  startTime String
  endTime   String

  mentor mentorProfile @relation(fields: [mentorId], references: [mentorId], onDelete: Cascade)

  @@unique([mentorId, date, startTime, endTime])
  @@index([mentorId, date])
}

model Channel {
  channelId   String   @id @default(uuid())
  mentorId    String
  name        String
  category    String
  topic       String
  description String
  tags        String[] @default([])
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  isDeleted   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  mentor mentorProfile @relation(fields: [mentorId], references: [mentorId], onDelete: Cascade)
  posts  ChannelPost[]

  @@index([mentorId, createdAt])
  @@index([mentorId, name])
}




enum ChannelPostType {
  article
  video
  document
}

enum ChannelPostStatus {
  draft
  published
}

model ChannelPost {
  postId      String            @id @default(uuid())
  channelId   String
  mentorId    String
  type        ChannelPostType
  title       String
  content     String?
  description String?
  category    String?
  subject     String?
  tags        String[]          @default([])
  mediaKey    String?
  mediaName   String?
  mediaMimeType String?
  thumbnailKey String?
  thumbnailName String?
  thumbnailMimeType String?
  status      ChannelPostStatus @default(published)
  viewCount   Int               @default(0)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  channel     Channel           @relation(fields: [channelId], references: [channelId], onDelete: Cascade)
  mentor      mentorProfile     @relation(fields: [mentorId], references: [mentorId], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([mentorId, createdAt])
  @@index([status])
  @@index([type])
}
